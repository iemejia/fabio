{
  "name": "fabio-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website for the Fabio CLI",
  "scripts": {
    "dev": "npm run generate:reference && astro dev",
    "build": "npm run generate:reference && astro build",
    "preview": "astro preview",
    "generate:reference": "node scripts/generate-reference.mjs",
    "check": "npm run generate:reference && astro check && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
