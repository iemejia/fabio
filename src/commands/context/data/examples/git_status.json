{
  "command": "fabio git status --workspace $WS --include-files-details",
  "description": "Get item- and file-level Git sync status for a workspace.",
  "response": {
    "data": {
      "changes": [
        {
          "itemMetadata": {
            "itemIdentifier": {
              "objectId": "a1b2c3d4-0000-0000-0000-000000000001"
            },
            "itemType": "Notebook",
            "displayName": "SalesAnalysis"
          },
          "workspaceChange": "Modified",
          "remoteChange": "Modified",
          "conflictType": "Conflict",
          "fileChanges": [
            {
              "path": "notebook-content.py",
              "workspaceChange": "Modified",
              "remoteChange": "Modified",
              "conflictType": "Conflict"
            },
            {
              "path": "metadata.json",
              "workspaceChange": "Modified",
              "conflictType": "None"
            }
          ]
        }
      ],
      "workspaceHead": "abc123def456",
      "remoteCommitHash": "abc123def456"
    }
  },
  "notes": "This is an LRO endpoint. --include-files-details adds fileChanges; paths are relative to the item root and use forward slashes. workspaceChange and remoteChange may be omitted when that side has no change.",
  "query_examples": [
    {"query": "changes | length(@)", "description": "Count of pending changes."},
    {"query": "changes[?workspaceChange=='Modified'].itemMetadata.displayName", "description": "Names of locally modified items."},
    {"query": "changes[].fileChanges[].path", "description": "All changed file paths."},
    {"query": "workspaceHead", "description": "Current workspace commit SHA."}
  ]
}
