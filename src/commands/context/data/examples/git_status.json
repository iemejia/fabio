{
  "command": "fabio git status --workspace $WS --include-file-details",
  "description": "Get workspace Git status with per-file changes for each changed item.",
  "response": {
    "data": [
      {
        "itemMetadata": {
          "itemIdentifier": {
            "objectId": "a1b2c3d4-0000-0000-0000-000000000001"
          },
          "itemType": "Notebook",
          "displayName": "SalesAnalysis"
        },
        "workspaceChange": "Modified",
        "remoteChange": "Modified",
        "conflictType": "Conflict",
        "fileChanges": [
          {
            "path": "notebook-content.py",
            "workspaceChange": "Modified",
            "remoteChange": "Modified",
            "conflictType": "Conflict"
          },
          {
            "path": "metadata.json",
            "workspaceChange": "Modified",
            "conflictType": "None"
          }
        ]
      }
    ],
    "count": 1
  },
  "notes": "This is an LRO endpoint. --include-file-details adds fileChanges; omit it for the smaller item-level response. File paths are relative to the item root and use forward slashes. workspaceChange and remoteChange values include Added, Modified, Deleted, and None. Use git commit --file-selection ITEM_ID=PATH to commit only selected files.",
  "query_examples": [
    {"query": "length(@)", "description": "Count of pending item changes."},
    {"query": "[?workspaceChange=='Modified'].itemMetadata.displayName", "description": "Names of locally modified items."},
    {"query": "[].fileChanges[].path", "description": "All changed file paths."}
  ]
}
