{
  "command": "fabio environment get-staging-spark-settings --workspace $WS --id $ENV",
  "description": "Shows staging Spark compute and live-pool hydration settings.",
  "response": {
    "data": {
      "instancePool": {
        "name": "MyWorkspacePool",
        "type": "Workspace",
        "id": "78942136-106c-4f3e-80fc-7ff4eae11603",
