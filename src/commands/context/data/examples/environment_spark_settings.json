  "query_examples": [
    {"query": "instancePool.maxClustersToHydrateLimit", "description": "Capacity-specific hydration limit."},
    {"query": "customLivePoolSupport", "description": "Whether live-pool hydration is active."},
    {"query": "customLivePoolSettings.maxClustersToHydrate", "description": "Configured pre-hydrated cluster count."}
